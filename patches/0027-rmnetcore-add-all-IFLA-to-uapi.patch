From 1117259cacda2cb68336ec6bd1e2e479f2062bc7 Mon Sep 17 00:00:00 2001
From: Daniele Palmas <dnlplm@gmail.com>
Date: Fri, 18 Oct 2024 11:26:16 +0200
Subject: [PATCH 27/31] rmnetcore: add all IFLA to uapi

---
 .../ethernet/qualcomm/rmnet/rmnet_config.c    | 29 ++++++++++---------
 include/uapi/linux/if_link.h                  |  3 ++
 2 files changed, 18 insertions(+), 14 deletions(-)

diff --git a/drivers/net/ethernet/qualcomm/rmnet/rmnet_config.c b/drivers/net/ethernet/qualcomm/rmnet/rmnet_config.c
index 80458b252fab..4cad4c131b8f 100644
--- a/drivers/net/ethernet/qualcomm/rmnet/rmnet_config.c
+++ b/drivers/net/ethernet/qualcomm/rmnet/rmnet_config.c
@@ -15,16 +15,7 @@
 #include "rmnet_vnd.h"
 #include "rmnet_private.h"
 
-/* Local Definitions and Declarations */
-
-enum {
-	IFLA_RMNET_QUEUE = __IFLA_RMNET_MAX,
-	IFLA_RMNET_TYPE,
-	IFLA_RMNET_QUEUE_NUM,
-	__IFLA_RMNET_EXT_MAX,
-};
-
-static const struct nla_policy rmnet_policy[__IFLA_RMNET_EXT_MAX] = {
+static const struct nla_policy rmnet_policy[__IFLA_RMNET_MAX] = {
 	[IFLA_RMNET_MUX_ID]	= { .type = NLA_U16 },
 	[IFLA_RMNET_FLAGS]	= { .len = sizeof(struct ifla_rmnet_flags) },
 	[IFLA_RMNET_QUEUE]	= { .len = sizeof(struct rmnet_queue_mapping) },
@@ -233,16 +224,26 @@ static int rmnet_newlink(struct net *src_net, struct net_device *dev,
 	mux_id = nla_get_u16(data[IFLA_RMNET_MUX_ID]);
 
 	if(!tb[IFLA_RMNET_TYPE]) {
+		netdev_info(dev, "TYPE: %u\n", IFLA_RMNET_TYPE);
+		netdev_err(dev, "RMNET type not specified\n");
 		NL_SET_ERR_MSG_MOD(extack, "RMNET type not specified");
 		goto register_dev;
 	}
 	type = nla_get_u8(data[IFLA_RMNET_TYPE]);
 
-	if (type == RMNET_TYPE_ETH) {
-		queue_num = nla_get_u8(data[IFLA_RMNET_QUEUE_NUM]);
-		netdev_dbg(dev, "queue num: %d\n", queue_num);
+	if (tb[IFLA_RMNET_QUEUE_NUM]) {
+		if (type == RMNET_TYPE_ETH) {
+			queue_num = nla_get_u8(data[IFLA_RMNET_QUEUE_NUM]);
+			netdev_dbg(dev, "queue num: %d\n", queue_num);
+		}
+	} else {
+		if (type == RMNET_TYPE_ETH)
+			queue_num = 1;
 	}
 
+	netdev_info(dev, "netdev mux: %u\n", mux_id);
+	netdev_info(dev, "netdev type: %u\n", type);
+	netdev_info(dev, "netdev queue: %u\n", queue_num);
 register_dev:
 	err = rmnet_register_real_device(real_dev, extack);
 	if (err)
@@ -519,7 +520,7 @@ static int rmnet_fill_info(struct sk_buff *skb, const struct net_device *dev)
 
 struct rtnl_link_ops rmnet_link_ops __read_mostly = {
 	.kind		= "rmnet",
-	.maxtype	= __IFLA_RMNET_EXT_MAX - 1,
+	.maxtype	= __IFLA_RMNET_MAX - 1,
 	.priv_size	= sizeof(struct rmnet_priv),
 	.setup		= rmnet_vnd_setup,
 	.validate	= rmnet_rtnl_validate,
diff --git a/include/uapi/linux/if_link.h b/include/uapi/linux/if_link.h
index 5e7a1041df3a..408bfcee497d 100644
--- a/include/uapi/linux/if_link.h
+++ b/include/uapi/linux/if_link.h
@@ -1356,6 +1356,9 @@ enum {
 	IFLA_RMNET_UNSPEC,
 	IFLA_RMNET_MUX_ID,
 	IFLA_RMNET_FLAGS,
+	IFLA_RMNET_TYPE,
+	IFLA_RMNET_QUEUE_NUM,
+	IFLA_RMNET_QUEUE,
 	__IFLA_RMNET_MAX,
 };
 
-- 
2.43.0

