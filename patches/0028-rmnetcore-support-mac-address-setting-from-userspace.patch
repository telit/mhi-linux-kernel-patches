From 5fa888e1ccf6dc60e65e4557bcd81761302dea52 Mon Sep 17 00:00:00 2001
From: Daniele Palmas <dnlplm@gmail.com>
Date: Mon, 28 Oct 2024 09:30:28 +0100
Subject: [PATCH 28/31] rmnetcore: support mac address setting from userspace

---
 drivers/net/ethernet/qualcomm/rmnet/rmnet_vnd.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/drivers/net/ethernet/qualcomm/rmnet/rmnet_vnd.c b/drivers/net/ethernet/qualcomm/rmnet/rmnet_vnd.c
index 4424aa3ae08f..a727e7f884fa 100644
--- a/drivers/net/ethernet/qualcomm/rmnet/rmnet_vnd.c
+++ b/drivers/net/ethernet/qualcomm/rmnet/rmnet_vnd.c
@@ -168,6 +168,17 @@ static u16 rmnet_vnd_select_queue(struct net_device *dev,
 	return (*txq < dev->num_tx_queues) ? *txq : 0;
 }
 
+static int rmnet_set_mac_address(struct net_device *dev, void *p)
+{
+	int ret;
+
+	ret = eth_prepare_mac_addr_change(dev, p);
+	if (ret < 0)
+		return ret;
+	eth_commit_mac_addr_change(dev, p);
+	return 0;
+}
+
 static const struct net_device_ops rmnet_vnd_ops = {
 	.ndo_start_xmit = rmnet_vnd_start_xmit,
 	.ndo_change_mtu = rmnet_vnd_change_mtu,
@@ -178,6 +189,7 @@ static const struct net_device_ops rmnet_vnd_ops = {
 	.ndo_uninit     = rmnet_vnd_uninit,
 	.ndo_get_stats64 = rmnet_get_stats64,
 	.ndo_select_queue = rmnet_vnd_select_queue,
+	.ndo_set_mac_address = rmnet_set_mac_address,
 };
 
 static const char rmnet_gstrings_stats[][ETH_GSTRING_LEN] = {
-- 
